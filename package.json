{
  "name": "crowdfill",
  "version": "1.1.0",
  "private": true,
  "description": "Create realistic Google Forms responses with the tendency you choose. Test forms, fill dashboards with demo data and show how results lean.",
  "license": "MIT",
  "homepage": "https://dyrt.io/crowdfill/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Simon-commit/crowdfill.git"
  },
  "bugs": "https://github.com/Simon-commit/crowdfill/issues",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/icons.mjs",
    "package": "node scripts/build.mjs --zip",
    "check": "npm run check:text && npm run typecheck && npm run test && npm run build",
    "e2e": "npm run build && node e2e/run.mjs",
    "screenshots": "npm run build && node e2e/run.mjs --screenshots",
    "check:text": "node scripts/check-text.mjs",
    "store-assets": "node scripts/store-assets.mjs",
    "site": "node scripts/build-site.mjs",
    "video": "npm run build && node video/record.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@puppeteer/browsers": "^3.2.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "marked": "^18.0.14",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "google-forms",
    "chrome-extension",
    "test-data",
    "synthetic-data",
    "form-filler",
    "survey",
    "qa"
  ],
  "author": "dyrt.io (https://dyrt.io)"
}
